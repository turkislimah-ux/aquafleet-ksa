# Copy this file to .env.local and fill with your Supabase project values.
# .env.local is gitignored — never commit real keys.
# Use ONLY the anon public key here. Never put the service_role key in this project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# THE HOST'S CLOCK. Set on Vercel as well, in every environment including
# preview — Vercel runs UTC by default, a developer machine here runs Riyadh, and
# a date helper that reads the host answers a different day on the two of them
# for the first three hours of every Riyadh day. The database has no such
# ambiguity: 32 migrations pin `at time zone 'Asia/Riyadh'` explicitly.
#
# THIS IS A BELT, NOT THE FIX. lib/utils.ts names Asia/Riyadh in the formatter
# itself, so every bucket key is correct even where this is unset — which is the
# case that matters, because an env var can be deleted from a dashboard without
# an error, a failing test or any other signal. Nothing here should ever be the
# only reason a money figure lands in the right month. Keep both.
TZ=Asia/Riyadh

# PDFShift key for invoice PDF export (lib/pdf.ts). Left EMPTY on purpose —
# it is a real secret, not a placeholder to fill in with a fake value.
# Unset, Download PDF degrades to a "PDF service not configured" message
# rather than failing; everything else works without it.
PDF_API_KEY=
