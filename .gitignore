*.log
.DS_Store
.env*.local
.next
# scripts/safe-build.sh --dist-dir writes here. Its own error message suggests
# `--dist-dir .next-verify`, and without this line that build leaves ~400
# untracked files in `git status` — the same "swept up by git add -A" hazard the
# script's tsconfig restore exists to prevent. Matches .next-anything; the
# tracked next-env.d.ts has no leading dot, so it is unaffected.
.next-*
.tunnel.log
.turbo
.vercel
node_modules
out
*.tsbuildinfo
test-results

# GSD plugin owns .planning/HANDOFF.json and rewrites it from an empty
# template after tool calls. Ours is .planning/AQUAFLEET-HANDOFF.json (CLAUDE.md §5).
.planning/HANDOFF.json
preview/.planning/HANDOFF.json

# Not GSD's — a root-level handoff DRAFT (~310 KB) that gets rewritten by hand
# during a session. The finished record is .planning/HANDOFF.md, which IS
# committed. Ignored so no `git add .` can land the draft on main.
HANDOFF-for-review.md

# Per-machine Claude Code settings. NARROW ON PURPOSE — do NOT widen this to
# `.claude/`: launch.json and skills/aquafleet-domain/SKILL.md are tracked, and
# SKILL.md is the domain rulebook CLAUDE.md §4 tells every session to read.
.claude/settings.json
